<?php $this->extend('block_searchable'); ?>

<?php $this->block('content'); ?>

	<table>
		<tr>
			<th>Zeitraum</th>
			<th>Amtsinhaber</th>
		</tr>
		<?php foreach ($this->items as $item): ?>
			<tr class="<?= $item['class'] ?>">
				<td><?= $item['fromto'] ?></td>
				<td>
				<?php if ($item['playerbase_url']): ?>
					<a href="<?= $item['playerbase_url'] ?>"><?= $item['name'] ?></a>
				<?php else: ?>
					<?= $item['name'] ?>
				<?php endif; ?>
				</td>
			</tr>
		<?php endforeach; ?>
	</table>

<?php $this->endblock(); ?>
