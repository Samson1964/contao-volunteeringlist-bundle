{
    "name": "schachbulle/contao-volunteeringlist-bundle",
    "type": "contao-bundle",
    "description": "Funktionärslisten für Contao 4.13 und Contao 5 — verwaltet Amtsträger mit Amtszeiten, Lebensdaten und Bild und gibt sie im Frontend aus.",
    "keywords": [
        "contao",
        "funktionäre",
        "ehrenamt",
        "amtszeiten",
        "schach"
    ],
    "homepage": "https://github.com/Samson1964/contao-volunteeringlist-bundle",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Frank Hoppe",
            "homepage": "https://www.schachbulle.de/"
        }
    ],
    "require": {
        "php": "^8.1",
        "contao/core-bundle": "^4.13 || ^5.0",
        "schachbulle/contao-helper-bundle": "^2.0",
        "schachbulle/contao-spielerregister-bundle": "^3.0",
        "symfony/config": "^5.4 || ^6.4 || ^7.0",
        "symfony/dependency-injection": "^5.4 || ^6.4 || ^7.0",
        "symfony/http-kernel": "^5.4 || ^6.4 || ^7.0"
    },
    "conflict": {
        "contao/core": "*",
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0",
        "phpunit/phpunit": "^9.6"
    },
    "extra": {
        "contao-manager-plugin": "Schachbulle\\ContaoVolunteeringlistBundle\\ContaoManager\\Plugin"
    },
    "autoload": {
        "psr-4": {
            "Schachbulle\\ContaoVolunteeringlistBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Schachbulle\\ContaoVolunteeringlistBundle\\Tests\\": "tests/"
        }
    },
    "support": {
        "issues": "https://github.com/Samson1964/contao-volunteeringlist-bundle/issues",
        "source": "https://github.com/Samson1964/contao-volunteeringlist-bundle"
    }
}
